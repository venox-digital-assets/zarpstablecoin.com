---
import Layout from '../layouts/Layout.astro';

const exchanges = [
  {
    category: "Apps & Wallets",
    description: "Use ZARP in everyday life — send, receive, and spend.",
    items: [
      { name: "Coinbase", url: "https://www.coinbase.com/", logo: "/img/coinbase.svg", color: "#0052FF", desc: "Swap ZARP directly in Coinbase for users in North America." },
      { name: "Grow", url: "https://www.getgrowapp.co/", logo: "/img/getgrow.png", color: "#76B82A", desc: "Use ZARP to save and invest with a global investment account." },
      { name: "Mandla Money", url: "https://mandla.money/", logo: "/img/mandlamoney.svg", color: "#000000", desc: "Send and receive ZARP on WhatsApp or to any mobile number." },
      { name: "MetaMask", url: "https://metamask.io/", logo: "/img/metamask.svg", color: "#F6851B", desc: "The most popular wallet for Ethereum and EVM chains." },
      { name: "Moovha", url: "https://moovha.com/", logo: "/img/moovha.png", color: "#1E3A8A", desc: "Save, send, and spend in USD or Rands, powered by ZARP." },
      { name: "Phantom", url: "https://phantom.app/", logo: "/img/phantom.svg", color: "#AB9FF2", desc: "Multi-chain wallet for Solana, Ethereum, and more." },
      { name: "PumpPay", url: "https://www.pumppay.co.za/", logo: "/img/pumppay.svg", color: "#000000", desc: "Smart fuel payments powered by ZARP." },
      { name: "Rabby", url: "https://rabby.io/", logo: "/img/rabby.svg", color: "#7084FF", desc: "Smart wallet with built-in security for EVM chains." },
      { name: "ZARPLY", url: "https://zarply.co.za/", logo: "/img/zarply.svg", color: "#000000", desc: "Be your own bank with the dedicated ZARP wallet on your mobile." }
    ]
  },
  {
    category: "Centralized Exchanges",
    description: "Buy and sell ZARP on custodial exchanges.",
    items: [
      { name: "AFRIDAX", url: "https://afridax.com/", logo: "/img/afridax.svg", color: "#000000", desc: "Crypto trading rooted in trust." },
      { name: "ChainEX", url: "https://chainex.io/", logo: "/img/chainex.svg", color: "#2d70e7", desc: "Africa's most affordable exchange." },
      { name: "EasyOnramp", url: "https://easyonramp.co.za/", logo: "/img/easyonramp.svg", color: "#000000", desc: "Transform your corporate treasury with ZARP." },
      { name: "Metacomp", url: "https://www.mce.sg/", logo: "/img/metacomp.png", color: "#000000", desc: "FX infrastructure provider." },
      { name: "OVEX", url: "https://www.ovex.io/", logo: "/img/ovex.svg", color: "#1e1e2f", desc: "High-volume OTC and RFQ trading." }
    ]
  },
  {
    category: "Decentralized Exchanges",
    description: "Swap other crypto for ZARP directly on-chain.",
    items: [
      { name: "Aerodrome", url: "https://aerodrome.finance/swap?from=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913&to=0xb755506531786c8ac63b756bab1ac387bacb0c04&chain0=8453&chain1=8453", logo: "/img/aerodrome.svg", color: "#000000", desc: "The central liquidity hub on Base." },
      { name: "Curve", url: "https://www.curve.finance/", logo: "/img/curve.png", color: "#0033FF", desc: "Efficient stablecoin swaps with deep on-chain liquidity." },
      { name: "Jupiter", url: "https://jup.ag/swap?sell=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v&buy=dngKhBQM3BGvsDHKhrLnjvRKfY5Q7gEnYGToj9Lk8rk", logo: "/img/jupiter.svg", color: "#16a34a", desc: "The home of on-chain finance." },
      { name: "Meteora", url: "https://app.meteora.ag/pools?token=dngKhBQM3BGvsDHKhrLnjvRKfY5Q7gEnYGToj9Lk8rk", logo: "/img/meteora.svg", color: "#ff3d00", desc: "Dynamic liquidity protocols on Solana." },
      { name: "Orca", url: "https://www.orca.so/trade?tokenIn=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v&tokenOut=dngKhBQM3BGvsDHKhrLnjvRKfY5Q7gEnYGToj9Lk8rk", logo: "/img/orca.svg", color: "#ffda59", desc: "User-friendly DEX on Solana." },
      { name: "Stabull", url: "https://app.stabull.finance/?chain=137&output=0xb755506531786C8aC63B756BaB1ac387bACB0C04", logo: "/img/stabull.svg", color: "#4f46e5", desc: "FX-optimized stablecoin AMM." },
      { name: "SuperSwap", url: "https://superswap.ink/", logo: "/img/superswap.svg", color: "#000000", desc: "Cross-chain DEX aggregator for seamless swaps." },
      { name: "Uniswap", url: "https://app.uniswap.org/swap?outputCurrency=0xb755506531786c8ac63b756bab1ac387bacb0c04", logo: "/img/uniswap.svg", color: "#ff007a", desc: "Swap on Ethereum, Polygon, and Base." }
    ]
  },
  {
    category: "Ecosystem Partners",
    description: "Infrastructure and security providers integrated with ZARP and ready to power your business.",
    items: [
      { name: "Arrel", url: "https://www.arreltech.com/", logo: "/img/arrel.png", color: "#000000", desc: "Institutional-grade digital asset infrastructure and custody." },
      { name: "BlockRadar", url: "https://blockradar.co/", logo: "/img/blockradar.svg", color: "#000000", desc: "Secure stablecoin wallet infrastructure." },
      { name: "Capa", url: "https://capa.fi/", logo: "/img/capa.svg", color: "#000000", desc: "Seamless cross-border payments." },
      { name: "Cyber-Mint", url: "https://www.cyber-mint.com/", logo: "/img/cybermint.avif", color: "#000000", desc: "Investing in and developing next-generation companies." },
      { name: "DFB", url: "https://www.dfb.network/", logo: "/img/dfb.png", color: "#000000", desc: "Decentralized FX infrastructure for stablecoin liquidity." },
      { name: "eZar", url: "https://www.ezar.network/", logo: "/img/ezar.png", color: "#000000", desc: "Digital rand payments for everyone." },
      { name: "Fireblocks", url: "https://www.fireblocks.com/", logo: "/img/fireblocks.svg", color: "#000000", desc: "Enterprise-grade digital asset security with built-in support for ZARP." },
      { name: "IFÁ Labs", url: "https://ifalabs.com/", logo: "/img/ifalabs.png", color: "#000000", desc: "Multi-chain oracle for accurate stablecoin pricing." },
      { name: "LI.FI", url: "https://li.fi/", logo: "/img/lifi.svg", color: "#000000", desc: "Bridge and DEX aggregation across all major chains." },
      { name: "LinkIO", url: "https://www.linkio.world/", logo: "/img/linkio.png", color: "#000000", desc: "Real-time FX infrastructure for modern payments." },
      { name: "NedaPay", url: "https://www.nedapay.xyz/", logo: "/img/nedapay.png", color: "#000000", desc: "Borderless stablecoin payments across 180+ countries." },
      { name: "SCRYPT", url: "https://scrypt.swiss/", logo: "/img/scrypt.svg", color: "#000000", desc: "Swiss-based partner for firms starting or scaling their crypto journey." },
      { name: "Utila", url: "https://utila.io/", logo: "/img/utila.svg", color: "#000000", desc: "Enterprise-grade digital asset operations and wallet infrastructure." }
    ]
  }
];

// Partner application form endpoint (Formspree). Submissions are emailed via Formspree.
const FORMSPREE_ENDPOINT = "https://formspree.io/f/mwlkkpzn";
---

<Layout
	title="ZARP Ecosystem | Apps, Wallets, Exchanges & More"
	ogTitle="ZARP Ecosystem"
	ogDescription="Explore the growing landscape of ZARP apps, wallets, exchanges, and more."
	ogImage="https://zarpstablecoin.com/img/og-ecosystem.jpg"
	ogUrl="https://zarpstablecoin.com/get-zarp"
>
  <main class="min-h-screen bg-slate-50 pt-24 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
          Where to Get <span class="text-[#009A35]">ZARP</span>
        </h1>
        <p class="text-xl text-slate-500 max-w-2xl mx-auto">
          Explore the ZARP ecosystem. Buy, trade, and use the Rand stablecoin across a growing network of exchanges, protocols, and partners.
        </p>
      </div>

      <div id="partner-application" class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 md:p-10 mb-12 flex flex-col md:flex-row md:items-center gap-6 md:gap-10 scroll-mt-24">
        <p class="flex-1 text-base text-slate-600 leading-relaxed">
          ZARP Stablecoin is made available through an Ecosystem of partners that are enabled to issue, redeem, earn yield, and perform other functions.
        </p>
        <button type="button" id="partner-open"
                class="shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3 bg-slate-900 text-white text-sm font-medium rounded-lg hover:bg-[#009A35] transition-colors">
          Become a ZARP Partner
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
        </button>
      </div>

      <div class="space-y-20">
        {exchanges.map((section) => (
          <section>
            <div class="mb-8 border-b border-slate-200 pb-4">
              <h2 class="text-2xl font-bold text-slate-900">{section.category}</h2>
              <p class="text-slate-500 mt-1">{section.description}</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {section.items.map((item) => (
                <a href={item.url} target="_blank" rel="noopener noreferrer" 
                   class="group bg-white rounded-xl shadow-sm hover:shadow-lg hover:-translate-y-1 border border-slate-100 hover:border-[#009A35]/20 p-6 flex items-start transition-all duration-300">
                  
                  <div class="h-14 w-14 shrink-0 mr-5 flex items-center justify-center bg-slate-50 rounded-xl p-3 group-hover:bg-[#009A35]/10 transition-colors">
                    <img src={item.logo} alt={item.name} class="max-h-full max-w-full object-contain" />
                  </div>
                  
                  <div class="flex-1">
                    <div class="flex items-center justify-between">
                      <h3 class="text-lg font-bold text-slate-900 group-hover:text-[#009A35] transition-colors">{item.name}</h3>
                      <svg class="w-4 h-4 text-slate-300 group-hover:text-[#009A35] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    </div>
                    <p class="text-sm text-slate-500 mt-2 line-clamp-2">{item.desc}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>

    </div>
  </main>

  <div id="partner-modal" class="hidden fixed inset-0 z-50 items-center justify-center p-4">
    <div id="partner-backdrop" class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm"></div>

    <div role="dialog" aria-modal="true" aria-labelledby="partner-modal-title"
         class="relative w-full max-w-lg max-h-[90vh] overflow-y-auto bg-white rounded-2xl shadow-xl border border-slate-100">

      <div class="flex items-start justify-between gap-4 p-6 border-b border-slate-100">
        <div>
          <h2 id="partner-modal-title" class="text-xl font-bold text-slate-900">Become a ZARP Partner</h2>
          <p class="text-sm text-slate-500 mt-1">Tell us about your business and we'll be in touch.</p>
        </div>
        <button type="button" id="partner-close" aria-label="Close"
                class="shrink-0 p-2 -m-2 rounded-md text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <form id="partner-form" action={FORMSPREE_ENDPOINT} method="POST" class="p-6 space-y-5">
        <input type="hidden" name="_subject" value="ZARP Partner Application" />
        <p class="hidden"><label>Leave this field empty <input name="_gotcha" tabindex="-1" autocomplete="off" /></label></p>

        <div>
          <label for="partner-name" class="block text-sm font-medium text-slate-700 mb-1.5">Name</label>
          <input type="text" id="partner-name" name="name" required autocomplete="name"
                 class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#009A35] focus:ring-2 focus:ring-[#009A35]/20 transition-colors" />
        </div>

        <div>
          <label for="partner-email" class="block text-sm font-medium text-slate-700 mb-1.5">Email address</label>
          <input type="email" id="partner-email" name="email" required autocomplete="email"
                 class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#009A35] focus:ring-2 focus:ring-[#009A35]/20 transition-colors" />
        </div>

        <div>
          <label for="partner-company" class="block text-sm font-medium text-slate-700 mb-1.5">Company name</label>
          <input type="text" id="partner-company" name="company" required autocomplete="organization"
                 class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#009A35] focus:ring-2 focus:ring-[#009A35]/20 transition-colors" />
        </div>

        <div>
          <label for="partner-description" class="block text-sm font-medium text-slate-700 mb-1.5">Description of the business</label>
          <textarea id="partner-description" name="description" rows="4" required
                    placeholder="What does your business do, and how would you use ZARP?"
                    class="w-full px-4 py-2.5 rounded-lg border border-slate-200 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-[#009A35] focus:ring-2 focus:ring-[#009A35]/20 transition-colors resize-y"></textarea>
        </div>

        <p id="partner-status" class="hidden text-sm" role="alert"></p>

        <button type="submit" id="partner-submit"
                class="w-full inline-flex items-center justify-center px-6 py-3 bg-slate-900 text-white text-sm font-medium rounded-lg hover:bg-[#009A35] disabled:opacity-60 disabled:cursor-not-allowed transition-colors">
          Submit application
        </button>
      </form>

      <div id="partner-success" class="hidden p-6">
        <div class="flex items-start gap-4">
          <div class="shrink-0 h-10 w-10 flex items-center justify-center rounded-full bg-[#009A35]/10">
            <svg class="w-5 h-5 text-[#009A35]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-slate-900">Application received</h3>
            <p class="text-sm text-slate-500 mt-1">Thanks for your interest in partnering with ZARP. Our team will review your submission and get back to you.</p>
          </div>
        </div>
        <button type="button" id="partner-done"
                class="mt-6 w-full inline-flex items-center justify-center px-6 py-3 bg-slate-900 text-white text-sm font-medium rounded-lg hover:bg-[#009A35] transition-colors">
          Close
        </button>
      </div>

    </div>
  </div>

  <script>
    const modal = document.getElementById('partner-modal');
    const backdrop = document.getElementById('partner-backdrop');
    const openBtn = document.getElementById('partner-open');
    const closeBtn = document.getElementById('partner-close');
    const doneBtn = document.getElementById('partner-done');
    const form = document.getElementById('partner-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('partner-submit') as HTMLButtonElement | null;
    const status = document.getElementById('partner-status');
    const success = document.getElementById('partner-success');
    const firstField = document.getElementById('partner-name');

    let lastFocused: HTMLElement | null = null;

    function setStatus(message: string, isError: boolean) {
      if (!status) return;
      status.textContent = message;
      status.className = isError
        ? 'text-sm text-red-600'
        : 'text-sm text-slate-500';
    }

    function openModal() {
      lastFocused = document.activeElement as HTMLElement;
      // Reset to the form view in case the modal was last closed on the success panel.
      form?.classList.remove('hidden');
      success?.classList.add('hidden');
      status?.classList.add('hidden');
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
      document.body.classList.add('overflow-hidden');
      firstField?.focus();
    }

    function closeModal() {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
      lastFocused?.focus();
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    doneBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal?.classList.contains('hidden')) closeModal();
    });

    // Deep link: /get-zarp#partner-application opens the form directly (used by the footer link).
    if (window.location.hash === '#partner-application') openModal();
    window.addEventListener('hashchange', () => {
      if (window.location.hash === '#partner-application') openModal();
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      }
      status?.classList.add('hidden');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' }
        });

        if (res.ok) {
          form.reset();
          form.classList.add('hidden');
          success?.classList.remove('hidden');
        } else {
          const data = await res.json().catch(() => null);
          const detail = data?.errors?.map((err: { message: string }) => err.message).join(', ');
          status?.classList.remove('hidden');
          setStatus(detail || 'Something went wrong. Please try again, or email hello@zarpstablecoin.com.', true);
        }
      } catch {
        status?.classList.remove('hidden');
        setStatus('Could not reach the server. Please check your connection, or email hello@zarpstablecoin.com.', true);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit application';
        }
      }
    });
  </script>
</Layout>
